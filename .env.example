# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# .env / Docker secret 仅用于首次启动 bootstrap；WebUI 保存会写入
# turb.sqlite3 的 runtime_config，覆盖 config/*.py 默认值。

# ---- WebUI 授权 ----
# WebUI 登录授权码；首次 bootstrap 可放在 .env，之后由 SQLite 持久化
WEBUI_AUTH_CODE=
# 可选：Session Cookie 签名密钥；留空时从固定授权码派生，修改授权码会使已有登录失效
WEBUI_SESSION_SECRET=
# HTTPS reverse proxy 时设为 True；Docker production 已在 compose 中开启
WEBUI_SECURE_COOKIE=


# ---- 功能开关 ----
# 启用 Codex OAuth: 注册成功后自动跑 Codex 授权（全新session+接码），落盘 codex-邮箱.json
ENABLE_CODEX_AUTO=

# ---- 注册方式 ----
# 注册驱动: protocol=纯协议；roxy=RoxyBrowser；cloak=CloakBrowser；browser_use=Browser Use Cloud+Playwright
REGISTRATION_DRIVER=
# 注册后查到明确 Free 且无 Free Plus 试用资格时自动排队 Codex 补跑；同时自动开启注册后套餐查询
AUTO_CODEX_FOR_FREE_AFTER_REGISTER=

# ---- CloakBrowser ----
# Cloak无头: True=无头运行；False=显示浏览器窗口
CLOAK_HEADLESS=
# Cloak人工行为: 启用 CloakBrowser humanize 鼠标/键盘/滚动行为
CLOAK_HUMANIZE=
# Cloak按出口定位: 按当前出口 IP 自动匹配时区/语言/WebRTC IP；支持显式代理、系统代理/VPN
CLOAK_GEOIP=
# Cloak语言: 留空自动；日本可填 ja-JP，美国 en-US
CLOAK_LOCALE=
# Cloak时区: 留空自动；日本可填 Asia/Tokyo，美国 America/Los_Angeles
CLOAK_TIMEZONE=
# Cloak使用代理: 把本项目传入或代理池抽取的代理传给 CloakBrowser
CLOAK_USE_PROXY=
# Cloak License: Pro license；留空使用免费 binary
CLOAK_LICENSE_KEY=
# Cloak指纹Seed: 留空每次随机；固定值可保持同一指纹
CLOAK_FINGERPRINT_SEED=
# Cloak用户目录: 留空使用临时上下文；填写路径则持久化 cookies/cache
CLOAK_USER_DATA_DIR=
# Cloak超时: 页面和元素等待超时时间，秒
CLOAK_SELENIUM_TIMEOUT=
# 保留Cloak浏览器: 调试时开启，任务结束后不自动关闭
CLOAK_KEEP_BROWSER_OPEN=

# ---- Browser Use ----
# Browser Use API Key: 保存在 .env（BROWSER_USE_API_KEY），不写回 config/*.py
BROWSER_USE_API_KEY=
# 代理国家代码: 两位国家码，如 jp/us/sg；配合 Browser Use 内置 residential proxy
BROWSER_USE_PROXY_COUNTRY_CODE=
# 使用内置代理: True=连接参数带 proxyCountryCode；False=不强制传国家代理参数
BROWSER_USE_USE_PROXY=
# Profile ID: 可选。填写则复用 Browser Use profile 的 cookies/localStorage；批量建议留空
BROWSER_USE_PROFILE_ID=
# CDP 地址: 默认 wss://connect.browser-use.com
BROWSER_USE_CDP_BASE=
# 操作超时(秒): Playwright 默认操作超时
BROWSER_USE_TIMEOUT=
# 快速模式: 减少 Browser Use 额外等待和 humanize 延迟；建议开启，异常排查时可关闭
BROWSER_USE_FAST_MODE=
# 耗时日志: 打印 Browser Use 各阶段耗时：连接、打开页面、邮箱、OTP、手机、callback
BROWSER_USE_LOG_TIMING=
# 保留远端会话: 调试时可不主动 browser.close()；默认 False
BROWSER_USE_KEEP_BROWSER_OPEN=
# 起始 URL: 默认 https://chatgpt.com/auth/login
BROWSER_USE_START_URL=

# ---- Skyvern ----
# Skyvern API Key：用于创建 Browser Session
SKYVERN_API_KEY=
# API 地址：默认 https://api.skyvern.com
SKYVERN_API_BASE=
# Browser Session 超时（分钟）
SKYVERN_BROWSER_SESSION_TIMEOUT=
# 可选：复用 Skyvern browser profile
SKYVERN_BROWSER_PROFILE_ID=
# 可选：Skyvern 代理地区；jp 会自动转 RESIDENTIAL_JP
SKYVERN_PROXY_LOCATION=
# 浏览器类型：默认 stealth-chromium；可选 msedge/chrome/stealth-chromium
SKYVERN_BROWSER_TYPE=
# 是否启用广告拦截
SKYVERN_AD_BLOCKER=
# 结束时是否保存 browser profile
SKYVERN_GENERATE_BROWSER_PROFILE=
# 调试时保留浏览器
SKYVERN_KEEP_BROWSER_OPEN=
# 起始 URL
SKYVERN_START_URL=

# ---- RoxyBrowser ----
# Roxy API 地址: 默认 http://127.0.0.1:50000；需在 Roxy 应用 API 配置中开启
ROXY_API_BASE=
# Roxy API Key: 保存在 .env（ROXY_API_TOKEN），不写回 config/*.py
ROXY_API_TOKEN=
# Roxy 环境ID: 指定要打开的 Roxy 浏览器环境/Profile ID；留空则尝试创建临时环境
ROXY_PROFILE_ID=
# Roxy 工作区ID: 创建一号一环境时必填，会作为 workspaceId 提交给 Roxy 创建 Profile 接口
ROXY_WORKSPACE_ID=
# Roxy 项目ID: 从 /browser/workspace 的 project_details.projectId 获取；创建 Profile 时会作为 projectId 提交
ROXY_PROJECT_ID=
# 获取团队接口: 默认 /browser/workspace；点击获取团队/项目时会先试此路径，再自动尝试常见兼容路径
ROXY_WORKSPACE_LIST_PATH=
# 打开接口路径: 默认 /browser/open；如 Roxy 版本不同可在此调整
ROXY_OPEN_PATH=
# 无头启动窗口: 打开 Roxy 环境时向 /browser/open 传 headless；False=显示窗口，True=无头启动
ROXY_OPEN_HEADLESS=
# 关闭接口路径: 默认 /browser/close
ROXY_CLOSE_PATH=
# 保留浏览器: 调试时可开启，任务结束后不自动关闭 Roxy 环境
ROXY_KEEP_BROWSER_OPEN=
# Selenium execute_async_script 超时（秒）
ROXY_SCRIPT_TIMEOUT=
# 一号一环境: 每个账号强制创建新 Roxy Profile，用完关闭并删除，禁止复用固定环境
ROXY_ONE_PROFILE_PER_ACCOUNT=
# 结束后删除环境: 一号一环境模式下，任务结束后删除本轮创建的 Roxy Profile
ROXY_DELETE_PROFILE_AFTER_RUN=
# 创建环境使用代理池: 创建 Roxy 环境时从配置页「代理池」随机取一个代理，写入 Roxy proxyInfo
ROXY_CREATE_USE_PROXY_POOL=
# 代理检测通道: 写入 Roxy proxyInfo.checkChannel；留空则不传，默认 IPRust.io
ROXY_PROXY_CHECK_CHANNEL=
# 删除接口路径: 默认 /browser/delete；如 Roxy 版本不同可调整
ROXY_DELETE_PATH=

# ---- Roxy profile manager (independent from account registration) ----
ROXY_PROFILE_MANAGER_ENABLED=true
ROXY_PROFILE_MANAGER_OWNER_PREFIX=zcode-profile-manager
ROXY_PROFILE_ARCHIVE_DIR=
# 32-byte URL-safe base64 key; required before encrypted archive export
ROXY_PROFILE_ARCHIVE_KEY=
ROXY_PROFILE_ARCHIVE_MAX_BYTES=10485760
ROXY_PROFILE_FULL_ARCHIVE_MAX_BYTES=2147483648
# Validated with a disposable profile on the target Roxy version; disable to block local launch
ROXY_PROFILE_OFFLINE_OPEN_SUPPORTED=true
ROXY_PROFILE_ROXY_CHROME_PATH=
ROXY_PROFILE_CACHE_ROOT=
ROXY_PROFILE_OFFLINE_STAGING_DIR=
ROXY_PROFILE_OFFLINE_TIMEOUT=20
ROXY_PROFILE_ALLOW_CORE_VERSION_MISMATCH=false

# ---- CPA / Codex ----
# Codex授权驱动: protocol=原协议授权；roxy=用 RoxyBrowser；cloak=用 CloakBrowser；browser_use=用 Browser Use Cloud；skyvern=用 Skyvern；same_as_registration=跟随注册驱动
CODEX_OAUTH_DRIVER=

# ---- RoxyBrowser ----
# Codex回调超时: Roxy Codex OAuth 等待 localhost:1455 callback 的最长秒数
ROXY_CODEX_CALLBACK_TIMEOUT=

# ---- 功能开关 ----
# 启用 2FA(TOTP): 注册完成后自动设置动态口令（会多收一封 OTP 邮件）
ENABLE_2FA=
# 启用 Flow 触发: 注册成功后自动调用内部 Flow 接口（不影响注册结果）
ENABLE_FLOW_TRIGGER=

# ---- 人工节奏 ----
# 启用随机停顿: 在注册、OTP、授权等步骤之间加入随机等待，更接近人工操作节奏
ENABLE_HUMANIZE_DELAY=
# 停顿倍率: 随机停顿整体倍率；1.0=默认，0.5=减半，2.0=加倍
HUMANIZE_DELAY_FACTOR=

# ---- 邮箱 / OTP ----
# 自动取邮箱+收码: True=从邮箱池自动领邮箱并自动收 OTP；False=手动模式：用 REGISTER_EMAIL，OTP 在任务页手填
USE_EMAIL_SERVICE=
# 手动注册邮箱: USE_EMAIL_SERVICE=False 时必填。例如你的 outlook.com 地址；OTP 去网页邮箱看，再回任务页提交
REGISTER_EMAIL=
# 显示名称: 留空则自动生成英文名
REGISTER_NAME=
# OTP 最长等待(秒): 等待验证码邮件的最长秒数，超时判失败
OTP_MAX_WAIT=
# OTP 轮询间隔(秒): 每隔多少秒查一次新邮件
OTP_POLL_INTERVAL=
# 邮箱来源: 可填单个或多个，逗号分隔并按顺序兜底：outlook,generic_api,gmail_api_url,cloudflare_domain,cloudflare,gptmail,mailnest,cloudmail,gmail_123452026,paymesh,qan8_gmail_api
EMAIL_SOURCE=
# QAN8 Gmail API URL provider（每个 worker/lane 独占一个 mail gốc；source 耗尽后才按 quantity=1 懒购买替换）
QAN8_API_BASE=https://shop.qan8.com
QAN8_API_KEY=
QAN8_GMAIL_SKU_ID=
# Optional QAN8-only HTTP(S)/SOCKS5(H) proxy; leave empty to use NordVPN WireGuard when enabled, otherwise direct
QAN8_API_PROXY=
QAN8_REQUEST_TIMEOUT=15
QAN8_ORDER_TIMEOUT=120
QAN8_ALIASES_PER_SOURCE=12
GMAIL_123452026_API_BASE=http://gmail.123452026.xyz/api
GMAIL_123452026_REQUEST_TIMEOUT=30
GMAIL_123452026_ACCOUNTS_PER_CDK=6
# Gmail CDK provider dùng HTTP theo contract hiện tại; field này giữ để tương thích config cũ, không cần bật thủ công
GMAIL_123452026_ALLOW_INSECURE_HTTP=True
PAYMESH_API_BASE=https://sms.paymesh.cn
# 提链后端：auto 固定走本地 PAY.153 access-token checkout（使用旋转代理）；仅显式填 remote 才走旧 API/CDK
EXTRACT_LINK_MODE=auto
EXTRACT_LINK_API_BASE=
EXTRACT_LINK_CDK=
EXTRACT_LINK_LOCAL_BILLING_COUNTRY=PH
EXTRACT_LINK_LOCAL_CURRENCY=PHP
EXTRACT_LINK_LOCAL_PLAN_NAME=chatgptplusplan
EXTRACT_LINK_LOCAL_PROMO_CAMPAIGN_ID=plus-1-month-free
EXTRACT_LINK_LOCAL_APPLY_PROMO=True
EXTRACT_LINK_LOCAL_CHECKOUT_ATTEMPTS=3
EXTRACT_LINK_LOCAL_UPDATE_ATTEMPTS=3
# 单次 Paymesh HTTP 请求超时，不是 OTP 总等待时长
PAYMESH_REQUEST_TIMEOUT=30
# 每轮等待 Paymesh OTP 的最长秒数；Roxy 最多尝试 3 轮
PAYMESH_OTP_MAX_WAIT=60
PAYMESH_ACCOUNTS_PER_CDK=6
# Paymesh routed domain: thêm domain tùy chỉnh để tạo thêm alias local test,逗号分隔, tối đa 2
# Ví dụ test.com → ngoài xxx@gmail.com còn tạo xxx+hash@test.com để test local chống giả mạo email
PAYMESH_ROUTED_DOMAINS=
# Outlook取件模式: auto=远端优先，远端 402/DEPLOYMENT_DISABLED 自动切 Graph 直连；direct=只用 Microsoft Graph 直连；remote=只用远端服务
OUTLOOK_FETCH_MODE=
# 仅 cloudflare_domain：Email Routing 转发域名，如 mydomain.com（与 EMAIL_SOURCE=cloudflare 无关）
EMAIL_DOMAIN=
# 仅 cloudflare_domain：接收 Email Routing 转发的 QQ 邮箱，如 123456@qq.com
QQ_EMAIL=
# 仅 cloudflare_domain：QQ 邮箱 IMAP 授权码（不写回 config/*.py）
QQ_IMAP_PASSWORD=
# GPTMail API Key: 选择 EMAIL_SOURCE=gptmail 时必填；服务地址固定为 https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=

# TinyHost 临时邮箱（EMAIL_SOURCE=tinyhost）；取在线域名并生成 user@domain 地址
TINYHOST_API_BASE=https://tinyhost.shop
TINYHOST_REQUEST_TIMEOUT=20
TINYHOST_RANDOM_LOCAL_LENGTH=12

# Cloudflare Worker 临时邮箱（EMAIL_SOURCE 含 cloudflare 时；与 cloudflare_domain/QQ IMAP 不同）
# Worker API 根地址，例如 https://mail.example.com（不要末尾多余路径）
CLOUDFLARE_API_BASE=
# 匿名可空；admin 模式填 ADMIN_PASSWORD
CLOUDFLARE_API_KEY=
# none / bearer / x-api-key / x-admin-auth / query-key；admin 推荐 x-admin-auth
CLOUDFLARE_AUTH_MODE=
# Worker 全局密码，注入请求头 x-custom-auth；无则留空
CLOUDFLARE_CUSTOM_AUTH=
# 创建邮箱路径: 默认 /api/new_address；admin 创建常用 /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=
# 邮件列表路径: 默认 /api/mails
CLOUDFLARE_PATH_MESSAGES=
# 域名列表路径: 默认 /api/domains
CLOUDFLARE_PATH_DOMAINS=
# Token 路径: 默认 /api/token（fallback 预留）
CLOUDFLARE_PATH_TOKEN=
# 默认收信域名，逗号分隔，例如 mail.example.com；可留空由 Worker 决定
CLOUDFLARE_DEFAULT_DOMAINS=
# HTTP 请求超时秒数，默认 20
CLOUDFLARE_REQUEST_TIMEOUT=
# admin 创建时随机 local-part 长度，默认 10
CLOUDFLARE_NAME_LENGTH=
# MailNest-迈巢 Outlook 临时邮箱的 api key 获取页面 https://mailnest.top/account
MAIL_NEST_API_KEY=
# MailNest 项目代码：默认 chatgpt001
MAIL_NEST_PROJECT_CODE=
# CloudMail/Cloud Mail API 地址，例如 https://mail.example.com
CLOUDMAIL_API_BASE=
# CloudMail 管理员邮箱；填写账号密码后保存配置会自动获取 CLOUDMAIL_AUTH_TOKEN
CLOUDMAIL_ADMIN_EMAIL=
# CloudMail 登录密码
CLOUDMAIL_PASSWORD=
# CloudMail 生成 Token 接口路径，默认 /api/public/genToken
CLOUDMAIL_TOKEN_PATH=
# CloudMail/Cloud Mail API Authorization Token
CLOUDMAIL_AUTH_TOKEN=
# CloudMail 邮箱域名列表，每行一个
CLOUDMAIL_DOMAINS=
# 生成随机邮箱后是否自动调用 /api/public/addUser
CLOUDMAIL_AUTO_ADD_USER=
# 随机邮箱 local-part 长度
CLOUDMAIL_RANDOM_LOCAL_LENGTH=
# Remail 开放 API 文档：https://remail.aishop6.com/docs
# API 根地址；填写文档地址也可以，客户端会自动去掉 /docs
REMAIL_API_BASE=
# Remail 控制台生成的 rk- 开头 API Key
REMAIL_API_KEY=
# Remail 项目列表中的 projectId（用于 ChatGPT/OpenAI 验证码项目）
REMAIL_PROJECT_ID=2
# 下单邮箱后缀，默认 outlook.com
REMAIL_EMAIL_SUFFIX=
# code=短效接码；purchase=长效购买（可重复收件），默认 purchase
REMAIL_SERVICE_MODE=purchase
# private_first 或 public_only，默认 public_only
REMAIL_SUPPLY_POLICY=public_only
# 下单后等待 service token 补齐的最长秒数，默认 30
REMAIL_ORDER_WAIT_SECONDS=
# HTTP 请求超时秒数，默认 20
REMAIL_REQUEST_TIMEOUT=

# ---- 浏览器画像 ----
# 地区画像: 应与代理出口地区一致；可选 jp/cn/us/sg。当前本地代理实测为日本东京，推荐 jp
BROWSER_LOCALE_PROFILE=
# 按出口IP自动画像: 开启后每个 BrowserSession 会用当前代理出口 IP 自动选择语言/时区；失败时回退到地区画像
AUTO_BROWSER_LOCALE_FROM_IP=
# IP定位超时(秒): 出口 IP 地理信息接口的单次请求超时；接口失败会自动回退，不影响注册
IP_GEO_TIMEOUT=

# ---- 代理池 ----
# 代理池(每行一个): 支持 http(s)://user:pass@host:port 或 host:port:user:pass；为空则不使用代理
PROXY_POOL=
# Proxy xoay proxy.vn: mọi workflow lane giữ một keyxoay riêng và dùng lại proxy đến khi TTL hết
ROTATING_PROXY_ENABLED=false
ROTATING_PROXY_API_BASE=https://proxy.vn/proxyxoay
ROTATING_PROXY_PROXY_API_BASE=https://proxyxoay.shop/api
# API key tài khoản proxy.vn, chỉ lưu trong .env
ROTATING_PROXY_API_KEY=
# http hoặc socks5; proxyhttp/proxysocks5 từ API số 4
ROTATING_PROXY_PROTOCOL=http
# random hoặc nhà mạng/tỉnh thành theo danh sách của nhà cung cấp
ROTATING_PROXY_NHAMANG=random
ROTATING_PROXY_TINHTHANH=0
# IPv4 whitelist, nếu nhà cung cấp yêu cầu; có thể để trống
ROTATING_PROXY_WHITELIST=
ROTATING_PROXY_REQUEST_TIMEOUT=15
# 套餐查询网络模式: auto=本地代理可用则使用、未监听则直连；proxy=强制代理；direct=强制直连
PLAN_CHECK_PROXY_MODE=
# 套餐查询专用代理: 留空时 auto/proxy 从代理池选择；可能包含认证信息
PLAN_CHECK_PROXY=


# ---- NordVPN CLI ----
# 启用 NordVPN CLI 控制: True=启用命令行控制；False=所有操作静默跳过（安全默认）
NORDVPN_ENABLED=
# NordVPN 安装目录: NordVPN.exe 所在目录，默认 C:\Program Files\NordVPN
NORDVPN_INSTALL_DIR=
# CLI 超时(秒): 单次 connect/disconnect 命令的最长等待时间
NORDVPN_CLI_TIMEOUT=
# 连接后等待(秒): connect 成功后等待 NordLynx tunnel 稳定的额外秒数
NORDVPN_POST_CONNECT_DELAY=
# 国家分组: 逗号分隔的国家/专业服务器分组代码，如 "Japan,United_States"；留空连接最佳服务器
NORDVPN_COUNTRY_GROUPS=
# 自动轮换IP: True=每成功注册 N 个账号自动切换 NordVPN 服务器；False=关闭
NORDVPN_AUTO_ROTATE_ENABLED=
# 轮换间隔(个): 每成功注册多少个账号后自动切换一次 IP
NORDVPN_AUTO_ROTATE_INTERVAL=
NORDVPN_AUTO_ROTATE_COUNTRY_GROUP=

# ---- NordVPN WireGuard 代理（替代 NordVPN CLI，每个 Roxy 环境一个独立 SOCKS5） ----
# 原理: accessToken → NordVPN API 获取 NordLynx 私钥/在线服务器 → wireproxy 本地 SOCKS5
#       → 在 /browser/create 阶段写入 Roxy proxyInfo，之后才打开浏览器。
# wireproxy 下载: https://github.com/pufferffish/wireproxy （单文件，Windows 无需管理员）
# 总开关；关闭后即使填写 NORDVPN_ACCESS_TOKEN 也不会启用 WireGuard 代理
NORDVPN_WG_ENABLED=
# NordVPN accessToken: 仅保存在 .env；不会写入日志或 Roxy Profile
NORDVPN_ACCESS_TOKEN=
# 官方 API；通常无需修改
NORDVPN_API_BASE=https://api.nordvpn.com
NORDVPN_API_TIMEOUT=20
# 在线推荐服务器缓存秒数；每次创建仍会避开最近使用的服务器
NORDVPN_SERVER_CACHE_TTL=300
NORDVPN_SERVER_LIMIT=100
NORDVPN_RECENT_SERVER_COUNT=20
# 国家代码: JP/US/SG 等；留空使用 NordVPN 推荐服务器
NORDVPN_WG_COUNTRY_FILTER=
# accessToken 为空时的手工 .conf fallback 目录；token mode 可留空
NORDVPN_WG_CONFIGS_DIR=
# wireproxy 可执行文件；PATH 中没有时默认自动下载已 pin + SHA-256 校验的版本
NORDVPN_WG_WIREPROXY_EXE=wireproxy
NORDVPN_WG_AUTO_DOWNLOAD=True
# SOCKS5 端口范围；区间大小应 ≥ 最大并发 workers
NORDVPN_WG_PORT_START=25000
NORDVPN_WG_PORT_END=25099
# 等待 wireproxy 打开 SOCKS5 端口的最长秒数
NORDVPN_WG_CONNECT_TIMEOUT=15

# ---- CPA / Codex ----
# 授权地址来源: cpa=由 CPA 管理接口生成授权地址；local=旧版本地生成 PKCE 授权地址
CODEX_AUTH_URL_SOURCE=
# 补跑遇到浏览器临时网络断开时的整轮重试次数/间隔
CODEX_RETRY_NETWORK_ATTEMPTS=
CODEX_RETRY_NETWORK_DELAY=
# Lỗi đăng ký tạm thời trước khi tạo account được tạo tối đa bao nhiêu job mới (0 = tắt).
REGISTRATION_AUTO_RETRY_ATTEMPTS=
# CPA 管理地址: 例如 http://localhost:8317/admin/oauth；程序会取 origin 调用 /v0/management/*
CPA_MANAGEMENT_URL=
# 管理密钥: 保存在 .env（CPA_MANAGEMENT_KEY），不写回 config/*.py
CPA_MANAGEMENT_KEY=
# CPA 超时(秒): 请求 CPA 管理接口的超时时间
CPA_REQUEST_TIMEOUT=
# 保存CPA回执: CPA 未返回完整授权文件时，本地仍保存一份回调提交记录
CPA_SAVE_CALLBACK_RECEIPT=

# ---- sub2api ----
# sub2api 服务地址；Agent Token 上传和 Codex OAuth 共用
SUB2API_API_BASE=
# sub2api 管理 API Key；请求头默认使用 x-api-key
SUB2API_API_KEY=
# Secret for sub2api to authenticate automation callbacks from this worker
SUB2API_AUTOMATION_CALLBACK_SECRET=
# Agent Token/OAuth/Codex 补跑导出时绑定的分组 ID，每行一个；默认 14
SUB2API_GROUP_IDS=
# sub2api 账号默认优先级；默认 1，数值越小优先级越高
SUB2API_PRIORITY=
# Codex 补跑导出的模型 ID；支持逗号或换行分隔多个，留空使用 sub2api 默认模型
SUB2API_MODEL=

# ---- 接码平台 ----
# 接码通道: grizzly / viotp / hero / l / h；hero 使用 HeroSMS SMS-Activate-compatible API
SMS_PROVIDER=
# 国家代码: 传给接码平台的 country；GrizzlySMS 常用：美国=187；L/H 通道按本地后台配置填写
SMS_COUNTRY=
# 服务/项目代码: GrizzlySMS/L 作为 service；H 通道可复用为 projectId
SMS_SERVICE=
# 换号重试次数: 一个号收不到短信/被OpenAI拒时换下一个号，最多重试几次
SMS_MAX_RETRIES=
# 单号等短信(秒): 单个号等待短信到达的最长秒数，超时则换号
SMS_CODE_WAIT=
# GrizzlySMS API密钥: 保存在 .env（SMS_API_KEY），不写回 config/*.py
SMS_API_KEY=

# HeroSMS：OpenAI / ChatGPT service code 使用 dr
HERO_SMS_API_BASE=https://hero-sms.com/stubs/handler_api.php
HERO_SMS_API_KEY=
HERO_SMS_SERVICE=dr
# auto=实时 getPrices 按实际 cost 从低到高扫描；sticky country 只在同价位优先，较贵 sticky 等低价候选失败后再试；max price 只是不超过的硬上限；也可填固定 country ID
HERO_SMS_COUNTRY=auto
HERO_SMS_MAX_PRICE=0.1
HERO_SMS_COUNTRY_MIN_ATTEMPTS=4
HERO_SMS_COUNTRY_HIGH_FAILURE_RATE=0.75
# Sau bao nhiêu lỗi "số điện thoại đã được sử dụng" thì tạm đổi country khi auto
HERO_SMS_NUMBER_REJECT_THRESHOLD=3
# Cloak 页面导航遇到代理临时断开时的页面内重试次数/间隔
CLOAK_NAVIGATION_RETRIES=
CLOAK_NAVIGATION_RETRY_DELAY=
# ViOTP API 地址
VIOTP_API_BASE=https://api.viotp.com
# ViOTP Token: 保存在 .env，不写回 config/*.py
VIOTP_API_TOKEN=
# ViOTP serviceId（已查询到 OpenAI | ChatGPT = 1234；可通过 /service/getv2 重新查询）
VIOTP_SERVICE_ID=1234
# ViOTP 国家过滤（默认 vn）
VIOTP_COUNTRY=vn
# ViOTP 运营商过滤（默认 VINAPHONE；多个值用 | 分隔）
VIOTP_NETWORK=VINAPHONE
# H API 地址: H 取号服务基础地址，例如 http://localhost:8788
H_API_BASE=
# H 授权码: 保存在 .env（H_ADMIN_AUTH_CODE），不写回 config/*.py
H_ADMIN_AUTH_CODE=
# H 号码前缀: H 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
H_PHONE_PREFIX=
# H 取号方式: reusable=优先复用号码；new=每次取新号（调用 /api/admin/h/take-phone）
H_PHONE_ACQUIRE_MODE=
# L API 地址: L 取号服务基础地址，例如 http://localhost:8788
L_API_BASE=
# L 授权码: 保存在 .env（L_ADMIN_AUTH_CODE），不写回 config/*.py
L_ADMIN_AUTH_CODE=
# L 号码前缀: L 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
L_PHONE_PREFIX=
